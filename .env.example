# Copy these lines into .env.local and fill them in from
# Firebase Console → Project settings → Your apps → Web app → SDK setup and configuration.
# See FIREBASE_SETUP.md. Without them, collaboration is switched off and everything else works.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: where invitees without the app can get it (defaults to the GitHub Pages web app).
# Change to your App Store link once the app is published.
VITE_APP_DOWNLOAD_URL=
